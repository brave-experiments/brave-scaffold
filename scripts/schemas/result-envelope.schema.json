    },
    {
      "if": {
        "properties": {
          "command": {
            "const": "sync"
          }
        }
      },
      "then": {
        "properties": {
          "data": {
            "$ref": "command-data.schema.json#/$defs/sync"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "command": {
            "const": "sync-build"
          }
