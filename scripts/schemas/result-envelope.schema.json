    {
      "if": {
        "properties": {
          "command": {
            "const": "vpython3"
          }
        }
      },
      "then": {
        "properties": {
          "data": {
            "$ref": "command-data.schema.json#/$defs/vpython3"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "command": {
