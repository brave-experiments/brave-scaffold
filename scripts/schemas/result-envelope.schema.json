      },
      "then": {
        "properties": {
          "data": {
            "$ref": "command-data.schema.json#/$defs/drift"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "command": {
            "const": "env check"
          }
        }
      },
      "then": {
        "properties": {
          "data": {
            "$ref": "command-data.schema.json#/$defs/env check"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "command": {
