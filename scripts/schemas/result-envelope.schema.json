            "$ref": "command-data.schema.json#/$defs/env export"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "command": {
            "const": "env init"
          }
        }
      },
      "then": {
        "properties": {
          "data": {
            "$ref": "command-data.schema.json#/$defs/env init"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "command": {
            "const": "patches update"
          }
        }
      },
      "then": {
        "properties": {
          "data": {
            "$ref": "command-data.schema.json#/$defs/patches update"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "command": {
            "const": "run"
          }
        }
      },
      "then": {
        "properties": {
          "data": {
            "$ref": "command-data.schema.json#/$defs/run"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "command": {
            "const": "setup"
